# Supply-chain cooldown: do not install versions published less than 7 days ago.
min-release-age=7

# No `install-links=true` here any more. It existed because the SDK used to be consumed
# via a `file:../../dist` dependency: npm symlinks directory file: deps and does NOT
# install their dependencies, so the SDK's runtime `axios` was missing from this
# project's tree. That path dependency is gone — Dependabot's file fetcher could not
# resolve the uncommitted `dist/` and aborted every update job for the whole repo (see
# scripts/link-dist.mjs). `dist` is now symlinked in by that script instead, so this
# project declares `axios` directly in its own package.json (same range as the client's),
# which also keeps it lockfile-pinned and under the `npm audit` gate.
